 # Sets param_maps and column_maps from loader_param_grid
    param_maps, column_maps = zip(*iter_params(loader_param_grid, additional_params=loader_params))
    # extracted_data_list - List of data.x ('data') and data.y ('target') extracted from csv file for each 'segment'
    extracted_data_list = resolve_delayed(delayed(dataset.extract_data)(**param_map) for param_map in param_maps) # Iteresting external wrapping with resolve_delayed
    # Were he extracts data and applies transformations from loader_params
    # param_map contains the arguments for extract data
    # each param_map is the same except for 'feature_cnames'
    if callable(extract_data_callback): # https://www.geeksforgeeks.org/callable-in-python/
        extract_data_callback(extracted_data_list)

    print("[STATUS] RUNNING...")
    grid_search_results = []
    if write_validation:
        # open validation report for writing: 'w' - save as f
        f = open(f"reports/{save_name}-validation.txt", "w")
    # zip is essentially cartesian product, allows to set tuples
    for data, param_map, column_map in zip(extracted_data_list, param_maps, column_maps):
        if show_hist:
            # Only use of hist_df
            hist_df(pd.concat([data.x, data.y], axis=1), bins=15)
            # hist_df(pd.concat([data.x_scaled, data.y_scaled], axis=1), bins=15)
        # Writes a "segment" for each set of options (rows of output) defining column_map, feature_cnames, data.x.columns
        if write_validation:
            feature_cnames = param_map['feature_cnames']
            cols = list(data.x.columns.values)
            f.write(f"column_map: {column_map}\nfeature_cnames: {feature_cnames}\ndata.x.columns: {data.x.columns}\n\ndata.y.columns: {data.y.columns}\nparam_map: {param_map}\n\n\n")
            f.flush()
        # Setting up to train the regressors.
        grid_search_results.append(delayed(run_grid_search)(data, regressor, regressor_param_grid, cv=cv))
    if write_validation:
        f.close()

    grid_search_results = resolve_delayed(grid_search_results) # Removing the delayed tag, training regressors
    master_df = None
    for (df, best), column_map, data in zip(grid_search_results, column_maps, extracted_data_list):
        # __accuracy(best, data)
        if include_regressor_and_mlpdata:
            df["best_regressor"] = best
            df["mlp_data"] = data
        master_df = df_append(master_df, df, column_map) # adds column_map.items() information (tree branch) to row
    if save_df_report:
        save_df(master_df, save_name)
    # Moves everything not ending in _r2 or _r2adj to middle (front in this case)
    return df_reorder_columns(master_df, send_back=[col for col in master_df.columns if col.endswith("_r2") or col.endswith("_r2adj")])

def __accuracy(mlp, data):
