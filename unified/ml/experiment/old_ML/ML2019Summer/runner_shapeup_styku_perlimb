class ModifiedDataSet(DataSet):
    def load_data(self):
        combined_df = None
        for df in sources():
            df["SubjectID"] = standardize_subject_ids(df["SubjectID"])
            combined_df = combined_df.merge(df, on="SubjectID", how="outer",
                                            suffixes=('_1', '_2')) if combined_df is not None else df
