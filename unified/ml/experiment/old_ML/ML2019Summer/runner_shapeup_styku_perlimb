def sources(scans=True):
    sources = []
    dxa = pd.read_csv("data/DXA.csv")
    #The trunk BMC is divided into multiple other columns. The following code creates a new DXA column that sums up all those other columns
    dxa['TRUNK_BMC'] = dxa.apply(lambda x: x['LRIB_BMC'] + x['RRIB_BMC']+x['T_S_BMC'] + x['L_S_BMC'] + x['PELV_BMC'], axis=1)
    sources.append(dxa)
    sources.append(pd.read_csv("data/Styku_a_over_b.csv"))
    sources.append(pd.read_excel("data/Pennington_BodPod.xlsx"))
    sources.append(pd.read_excel("data/DXA_Q2_plusRegional_brief.xlsx").rename(
        columns={"Subject ID": "SubjectID"}))  # Remove space in column

    sources.append(pd.read_csv('data/Questionnaire.csv'))
    sources.append(pd.read_csv('data/Manual.csv'))
    sources.append(pd.read_csv('data/Blood.csv'))


    # sources.append(pd.read_excel("data/ObjOrganizerStyku_v6.xlsx").rename(columns={
    #    "waist circ": "waist_circ", "hip circ": "hip_circ"}))


    scan = "Styku"
    df = pd.read_excel(f"data/ObjOrganizer{scan}_v6.xlsx", na_values="[]")
    names = df["Name"]
    df.rename(columns={col: f"{scan}_{col.replace(' ', '_')}" for col in df.columns},
              inplace=True)  # Rename columns with dataset
    df["SubjectID"] = standardize_subject_ids(names)
    df = standardize_units_2(df)
    sources.append(df)
    return sources

